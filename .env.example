# Copy to .env (never commit .env). The IBKR password goes in secrets/tws_password, not here.

# IBKR username. With TRADING_MODE=paper, IB Gateway logs in to the paper account linked to it.
TWS_USERID=

# Your IB paper account ID, shown in the account menu after logging in to paper trading. Starts with DU.
LAB_PAPER_ACCOUNT=

# What the agents trade (signals: built-in names or promoted research hypotheses; tickers: from lab.toml).
LAB_SIGNALS=sma_trend
LAB_TICKERS=SPY QQQ

# Telegram alerts (optional): create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
LAB_TELEGRAM_TOKEN=
LAB_TELEGRAM_CHAT_ID=

# Optional: watch the IB Gateway screen over VNC at 127.0.0.1:5900
VNC_SERVER_PASSWORD=
