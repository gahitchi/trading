# Copy to .env (never commit .env).

# Symbols the recorder saves (Binance USD-M perpetuals).
LAB_RECORD_SYMBOLS=BTCUSDT ETHUSDT SOLUSDT

# Telegram alerts for `lab kill` / `lab resume` (optional): create a bot with @BotFather, message it once, then
# get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
LAB_TELEGRAM_TOKEN=
LAB_TELEGRAM_CHAT_ID=
